# ============================================================
# Changas API — variables de entorno
# Copiar a `.env` y completar:  cp .env.example .env
# El `.env` real NUNCA se commitea.
# ============================================================

# --- Base de datos ---
# Dev (SQLite, archivo local):
DATABASE_URL=sqlite+aiosqlite:///./changas.db
# Prod (PostgreSQL):
# DATABASE_URL=postgresql+asyncpg://usuario:password@localhost:5432/changas

# --- JWT ---
# Generar un secreto fuerte:  python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=
JWT_ALGORITHM=HS256
# Expiración del access token en minutos (1440 = 24 h; ver docs/SEGURIDAD.md)
JWT_EXPIRATION_MINUTES=1440

# --- CORS ---
# Orígenes permitidos separados por coma (sin espacios)
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Google OAuth ---
# Client ID de Google Cloud Console (OAuth 2.0). Vacío = login con Google deshabilitado.
GOOGLE_CLIENT_ID=
